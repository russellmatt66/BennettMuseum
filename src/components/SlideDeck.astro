---
const { slides = [], title = 'Exhibit gallery' } = Astro.props;
---

<div class="museum-slideshow" aria-label={title}>
  {slides.length > 0 ? (
    <>
      <div class="museum-slide-stage">
        {slides.map((slide, index) => (
          <figure class="museum-slide" hidden={index !== 0}>
            <img
              src={slide.src}
              alt={slide.alt || slide.title || 'Exhibit image'}
              loading="lazy"
            />
            <figcaption>
              {slide.title && <strong>{slide.title}</strong>}
              {slide.caption && <p>{slide.caption}</p>}
              {slide.credit && <small>{slide.credit}</small>}
            </figcaption>
          </figure>
        ))}
      </div>

      {slides.length > 1 && (
        <div class="museum-slide-controls">
          <button type="button" data-prev aria-label="Previous slide">←</button>
          <span class="museum-slide-count">
            <span data-current>1</span> / {slides.length}
          </span>
          <button type="button" data-next aria-label="Next slide">→</button>
        </div>
      )}
    </>
  ) : (
    <div class="placeholder">
      <span class="placeholder-icon">◈</span>
      <strong>EXHIBIT GALLERY</strong>
      <small>Add images using mediaSlides in the chapter Markdown.</small>
    </div>
  )}
</div>

<script>
  document.querySelectorAll('.museum-slideshow').forEach((deck) => {
    const slides = [...deck.querySelectorAll('.museum-slide')];
    const counter = deck.querySelector('[data-current]');
    let current = 0;

    function show(index) {
      if (!slides.length) return;
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.hidden = i !== current;
      });
      if (counter) counter.textContent = String(current + 1);
    }

    deck.querySelector('[data-prev]')?.addEventListener('click', () => {
      show(current - 1);
    });

    deck.querySelector('[data-next]')?.addEventListener('click', () => {
      show(current + 1);
    });

    deck.setAttribute('tabindex', '0');
    deck.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });
  });
</script>

<style>
  .museum-slideshow {
    width: 100%;
    min-width: 0;
    border: 1px solid #273649;
    border-radius: 12px;
    overflow: hidden;
    background: #0b1422;
  }

  .museum-slide[hidden] {
    display: none !important;
  }

  .museum-slide {
    margin: 0;
  }

  .museum-slide img {
    display: block;
    width: 100%;
    height: clamp(260px, 35vw, 480px);
    object-fit: contain;
    background: #080e18;
  }

  .museum-slide figcaption {
    padding: 20px 24px;
    color: #d5deea;
  }

  .museum-slide figcaption strong {
    display: block;
    font-size: 1.1rem;
    margin-bottom: 8px;
  }

  .museum-slide figcaption p {
    margin: 0 0 8px;
    line-height: 1.6;
  }

  .museum-slide figcaption small {
    color: #92a4bb;
  }

  .museum-slide-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 24px;
    border-top: 1px solid #273649;
    color: #92a4bb;
  }

  .museum-slide-controls button {
    background: transparent;
    border: 1px solid #34465c;
    border-radius: 6px;
    color: #d5deea;
    font-size: 1.5rem;
    cursor: pointer;
    padding: 4px 18px;
  }

  .museum-slide-controls button:hover {
    background: #1c3047;
  }
</style>
